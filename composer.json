{
    "name": "martin-lechene/crypto-payments",
    "description": "Laravel package to accept Bitcoin and Ethereum payments, with exchange-rate conversion, signed webhooks and an audit trail (beta).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "crypto",
        "bitcoin",
        "ethereum",
        "payments",
        "payment-gateway",
        "webhooks"
    ],
    "homepage": "https://github.com/martin-lechene/crypto-payment-laravel",
    "authors": [
        {
            "name": "Martin Lechene",
            "email": "contact@doganddev.eu"
        }
    ],
    "support": {
        "issues": "https://github.com/martin-lechene/crypto-payment-laravel/issues",
        "source": "https://github.com/martin-lechene/crypto-payment-laravel",
        "email": "contact@doganddev.eu",
        "docs": "https://github.com/martin-lechene/crypto-payment-laravel#readme"
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/events": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/queue": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/validation": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.5"
    },
    "autoload": {
        "psr-4": {
            "MartinLechene\\CryptoPayments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MartinLechene\\CryptoPayments\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MartinLechene\\CryptoPayments\\CryptoPaymentsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "format": "pint",
        "format-check": "pint --test"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
