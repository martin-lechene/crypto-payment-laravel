# ──────────────────────────────────────────────────────────────────────────────
# Crypto Payments – Environment Variables
# Copy this file to .env and fill in the values for your environment.
# ──────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
# "testnet" or "mainnet"
CRYPTO_NETWORK=testnet
CRYPTO_DEFAULT_CURRENCY=BTC

# ── Bitcoin Testnet (signet / testnet4) ───────────────────────────────────────
BTC_TESTNET_RPC=http://localhost:18332
BTC_TESTNET_USER=bitcoin
BTC_TESTNET_PASSWORD=changeme
# Set to false only when using a self-signed certificate on a private RPC node
BTC_TESTNET_VERIFY_SSL=true
# Required confirmations before a payment is considered confirmed
BTC_CONFIRMATIONS=3
# Esplora-compatible explorer used to detect incoming transactions
BTC_TESTNET_EXPLORER=https://blockstream.info/testnet/api

# ── Bitcoin Mainnet ───────────────────────────────────────────────────────────
BTC_MAINNET_ENABLED=false
BTC_MAINNET_RPC=
BTC_MAINNET_USER=
BTC_MAINNET_PASSWORD=
BTC_MAINNET_VERIFY_SSL=true
BTC_MAINNET_EXPLORER=https://blockstream.info/api

# ── Ethereum Testnet (Sepolia, chain_id 11155111) ─────────────────────────────
ETH_TESTNET_RPC=http://localhost:8545
ETH_TESTNET_VERIFY_SSL=true
# Etherscan-compatible explorer used to detect incoming transactions
ETH_TESTNET_EXPLORER=https://api-sepolia.etherscan.io/api
ETH_TESTNET_EXPLORER_KEY=
ETH_CONFIRMATIONS=12

# ── Ethereum Mainnet ──────────────────────────────────────────────────────────
ETH_MAINNET_ENABLED=false
ETH_MAINNET_RPC=
ETH_MAINNET_VERIFY_SSL=true
ETH_MAINNET_EXPLORER=https://api.etherscan.io/api
ETH_MAINNET_EXPLORER_KEY=

# ── Exchange Rates ────────────────────────────────────────────────────────────
# Supported: coingecko
EXCHANGE_RATES_PROVIDER=coingecko

# ── Monitoring (optional) ─────────────────────────────────────────────────────
CRYPTO_SLACK_WEBHOOK=
